# VYRO VPN - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Analytics or external services (not required for core functionality)
# VITE_APP_VERSION=2.5.4
# VITE_API_URL=http://localhost:3000

# No API keys required - VYRO VPN works 100% client-side
# All VPN simulation and UI logic runs in-browser
